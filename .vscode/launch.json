{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome at Localhost",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Development Server"
    },
    {
      "name": "Launch Edge at Localhost",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Development Server"
    }
  ]
}
